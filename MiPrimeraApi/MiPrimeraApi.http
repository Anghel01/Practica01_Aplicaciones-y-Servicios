@MiPrimeraApi_HostAddress = http://localhost:5055

### =========================================================
### 1. LOGIN COMO ADMIN (Rol: Admin)
### =========================================================
# @name loginAdmin
POST {{MiPrimeraApi_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "usuario": "admin",
  "password": "1234"
}

### Guardar token de Admin
@tokenAdmin = {{loginAdmin.response.body.token}}


### =========================================================
### 2. LOGIN COMO CLIENTE (Rol: Usuario)
### =========================================================
# @name loginCliente
POST {{MiPrimeraApi_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "usuario": "cliente",
  "password": "1234"
}

### Guardar token de Cliente
@tokenCliente = {{loginCliente.response.body.token}}


### =========================================================
### 3. PRUEBAS DE PRODUCTOS CON ROL: Usuario (Cliente)
### =========================================================

### 3.1 Consultar todos los productos (FUNCIONA - 200 OK)
GET {{MiPrimeraApi_HostAddress}}/api/Productos
Authorization: Bearer {{tokenCliente}}
Accept: application/json

### 3.2 Intentar crear producto con rol Usuario (DEBE DAR 403 FORBIDDEN)
POST {{MiPrimeraApi_HostAddress}}/api/Productos
Authorization: Bearer {{tokenCliente}}
Content-Type: application/json

{
  "nombre": "Café Expresso",
  "precio": 2.50,
  "activo": true
}


### =========================================================
### 4. PRUEBAS DE PRODUCTOS CON ROL: Admin
### =========================================================

### 4.1 Crear nuevo producto como Admin (201 Created)
# @name crearProducto
POST {{MiPrimeraApi_HostAddress}}/api/Productos
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "nombre": "Café Americano",
  "precio": 1.50,
  "activo": true
}

@nuevoProductoId = {{crearProducto.response.body.id}}

### 4.2 Consultar producto por ID
GET {{MiPrimeraApi_HostAddress}}/api/Productos/{{nuevoProductoId}}
Authorization: Bearer {{tokenAdmin}}
Accept: application/json

### 4.3 Actualizar producto como Admin (204 NoContent)
PUT {{MiPrimeraApi_HostAddress}}/api/Productos/{{nuevoProductoId}}
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "nombre": "Café Americano Doble",
  "precio": 2.00,
  "activo": true
}

### 4.4 Eliminar producto como Admin (204 NoContent)
DELETE {{MiPrimeraApi_HostAddress}}/api/Productos/{{nuevoProductoId}}
Authorization: Bearer {{tokenAdmin}}
Accept: application/json


### =========================================================
### 5. PRUEBA EXAMEN CORTO ITID803_02: PROVEEDORES
### =========================================================

### 5.1 Crear Proveedor como Admin (201 Created)
POST {{MiPrimeraApi_HostAddress}}/api/Proveedores
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "nombre": "Distribuidora La Costa",
  "telefono": "0991234567",
  "activo": true
}
