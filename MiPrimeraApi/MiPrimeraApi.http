@MiPrimeraApi_HostAddress = http://localhost:5055

### =========================================================
### 1. LOGIN COMO ADMIN (Rol: Admin)
### =========================================================
# @name loginAdmin
POST {{MiPrimeraApi_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "usuario": "admin",
  "password": "1234"
}

### Guardar token de Admin
@tokenAdmin = {{loginAdmin.response.body.token}}


### =========================================================
### 2. LOGIN COMO CLIENTE (Rol: Usuario)
### =========================================================
# @name loginCliente
POST {{MiPrimeraApi_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "usuario": "cliente",
  "password": "1234"
}

### Guardar token de Cliente
@tokenCliente = {{loginCliente.response.body.token}}


### =========================================================
### 3. PRUEBAS CON ROL: Usuario (Cliente)
### =========================================================

### 3.1 Consultar todos los usuarios (DEBE FUNCIONAR - 200 OK)
GET {{MiPrimeraApi_HostAddress}}/api/Usuarios
Authorization: Bearer {{tokenCliente}}
Accept: application/json

### 3.2 Intentar crear usuario con rol Usuario (DEBE DAR 403 FORBIDDEN)
POST {{MiPrimeraApi_HostAddress}}/api/Usuarios
Authorization: Bearer {{tokenCliente}}
Content-Type: application/json

{
  "nombreUsuario": "No Autorizado",
  "correoElectronicousuario": "noautorizado@correo.com",
  "contrasenausuario": "pass123",
  "activo": true
}

### 3.3 Intentar eliminar usuario con rol Usuario (DEBE DAR 403 FORBIDDEN)
DELETE {{MiPrimeraApi_HostAddress}}/api/Usuarios/1
Authorization: Bearer {{tokenCliente}}
Accept: application/json


### =========================================================
### 4. PRUEBAS CON ROL: Admin
### =========================================================

### 4.1 Consultar todos los usuarios (DEBE FUNCIONAR - 200 OK)
GET {{MiPrimeraApi_HostAddress}}/api/Usuarios
Authorization: Bearer {{tokenAdmin}}
Accept: application/json

### 4.2 Crear nuevo usuario como Admin (DEBE FUNCIONAR - 200 OK)
POST {{MiPrimeraApi_HostAddress}}/api/Usuarios
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "nombreUsuario": "Nuevo Usuario Admin",
  "correoElectronicousuario": "admin_creado@correo.com",
  "contrasenausuario": "admin123",
  "activo": true
}

### 4.3 Eliminar usuario como Admin (DEBE FUNCIONAR - 204 NoContent o 404)
DELETE {{MiPrimeraApi_HostAddress}}/api/Usuarios/1002
Authorization: Bearer {{tokenAdmin}}
Accept: application/json
